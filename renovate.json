{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>juniqe-com/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)action\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*default:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["@earendil-works/pi-coding-agent"],
      "automerge": false
    }
  ]
}
